# ==============================================================================
# TalentBridge AI - Git Ignore Configuration
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets.json

# Streamlit runtime & credentials
.streamlit/credentials.toml
.streamlit/secrets.toml

# Testing & Coverage
.coverage
.coverage.*
.pytest_cache/
nosetests.xml
coverage.xml
htmlcov/
.hypothesis/
.tox/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDEs and Editors
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Large ML Datasets and Models (preserve directories via .gitkeep)
*.csv
*.tsv
*.xlsx
*.xls
*.jsonl
*.parquet
*.feather
*.h5
*.hdf5

# Serialized Model Artifacts & Checkpoints
*.pkl
*.pickle
*.joblib
*.pt
*.pth
*.onnx
*.bin
*.model

# Whitelist .gitkeep and documentation files in data/artifacts
!.gitkeep
!*.md
!*.py
